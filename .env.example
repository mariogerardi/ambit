# Datadog browser RUM configuration (public browser credentials)
VITE_DATADOG_SITE=datadoghq.com
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
# Optional: enable RUM in local development. Production enables configured RUM.
VITE_DATADOG_ENABLED=false

# Private server-side key: backend deployment only, never bundled in Vite.
DATADOG_API_KEY=
